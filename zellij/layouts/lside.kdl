layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Markdown IDE" {
        pane split_direction="vertical" {
            // Left pane: Yazi file manager (30%)
            pane size="20%" command="zels_ide.sh" {
                focus true
            }

            // Right pane: Helix on top, Leaf on bottom (70%)
            pane size="80%" split_direction="horizontal" {
                // Top right: Helix editor (50%)
                pane size="80%" name="Mitos" command="ms"

                // Bottom right: Leaf previewer (50%)
                pane size="20%" name="" 
            }
        }
    }
}
